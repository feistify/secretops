#!/usr/bin/python3 -I
"""Answers GET /api/status on 127.0.0.1:8086, so that the vault connection
check in the trial container sees a server. It holds no data."""

from http.server import BaseHTTPRequestHandler, HTTPServer


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        found = self.path == "/api/status"
        body = b'{"message":"Ok"}' if found else b"{}"
        self.send_response(200 if found else 404)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass


HTTPServer(("127.0.0.1", 8086), Handler).serve_forever()
