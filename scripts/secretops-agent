#!/bin/sh
# secretops-agent: SSH forced-command wrapper for agent access to the broker.
#
# Installed as the command= target in the broker user's authorized_keys entry
# for the agent's SSH key:
#
#   command="/usr/local/bin/secretops-agent",restrict ssh-ed25519 AAAA... agent
#
# The agent can only run a fixed set of secretops subcommands in exact shapes,
# plus "write-recipe" to upload recipe YAML via stdin and "help", which
# prints static usage text without calling the broker. Recipes are referenced
# by bare name and resolved inside RECIPE_DIR; the agent cannot name arbitrary
# broker-readable paths. approve-plan and reject-plan are intentionally absent:
# approval stays human-only, enforced at the SSH boundary, not by convention.
#
# This wrapper is intentionally dumb: validate, then exec. Keep it that way.
#
# Security-relevant paths are hardcoded below and are NOT taken from the
# environment: a forced-command boundary must not let the client redirect the
# broker binary or recipe directory. The two BEGIN/END CONFIG lines are the
# only lines a test harness rewrites.
set -eu

# --- BEGIN CONFIG (hardcoded; do not read from environment) ---
BROKER_BIN=/usr/local/bin/secretops-broker
RECIPE_DIR=/opt/secretops/recipes
# --- END CONFIG ---

MAX_RECIPE_BYTES=65536

deny() {
    echo "secretops-agent: denied: $1" >&2
    exit 1
}

# Recipe names: lowercase/digits/dot/dash/underscore, no leading dot, .yaml.
# No slashes, so the name can never escape RECIPE_DIR.
valid_recipe_name() {
    case "$1" in
        "" | .*) return 1 ;;
        *[!a-z0-9._-]*) return 1 ;;
        *.yaml) return 0 ;;
        *) return 1 ;;
    esac
}

# Plan ids are internally generated hex; accept only a safe token so a crafted
# --id cannot traverse out of the plan directory.
valid_plan_id() {
    case "$1" in
        "" | *[!a-zA-Z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

cmd="${SSH_ORIGINAL_COMMAND:-}"
[ -n "$cmd" ] || deny "no command"

nl='
'
case "$cmd" in
    *[\;\&\|\<\>\$\`\\\(\)\{\}\'\"]*) deny "shell metacharacters" ;;
    *"$nl"*) deny "newline in command" ;;
esac

# Split on whitespace only; globbing disabled, no eval anywhere.
set -f
# shellcheck disable=SC2086
set -- $cmd

[ "$1" != "secretops" ] || shift
[ "$#" -ge 1 ] || deny "no subcommand"

subcommand="$1"
shift

case "$subcommand" in
    help)
        [ "$#" -eq 0 ] || deny "help takes no arguments"
        cat <<'EOF_HELP'
secretops broker: safe secret operations for coding agents.
You work with secret names and plans; values never reach you.

Usage:
  secretops-local COMMAND            (local broker)
  ssh BROKER_ALIAS COMMAND           (remote broker)

Information:
  help                               Show this text
  version                            Show the broker version
  actions                            List actions the policy allows and denies

Plans:
  write-recipe NAME.yaml < FILE      Upload a recipe (names and metadata only, never values)
  plan --file NAME.yaml --save       Save a plan from an uploaded recipe; prints plan_id
  show-plan --id PLAN_ID             Show a plan and its status
  preflight-plan --id PLAN_ID        Check prerequisites without writing anything
  execute-plan --id PLAN_ID          Run an approved plan; a plan runs only once

Recipe names:
  Lowercase letters, digits, '.', '-' and '_'; end in .yaml; no leading dot.

Workflow:
  # 1. Upload a recipe and save a plan
  secretops-local write-recipe task.yaml < task.yaml
  secretops-local plan --file task.yaml --save

  # 2. Check it; if preflight fails, stop and tell the human
  secretops-local show-plan --id PLAN_ID
  secretops-local preflight-plan --id PLAN_ID

  # 3. If the action needs approval, ask the human to run in their own terminal
  #    (local broker; a remote broker has its own approval access):
  sudo -u secretops-broker /usr/local/bin/secretops-broker show-plan --id PLAN_ID
  sudo -u secretops-broker /usr/local/bin/secretops-broker approve-plan --id PLAN_ID

  # 4. After approval, run it
  secretops-local execute-plan --id PLAN_ID

  # To repeat an operation, save a new plan.

New secret whose value only the human has:
  # Plan a vault.secret.add recipe, then ask the human to run:
  secretops add --plan PLAN_ID
  # Do not execute that plan; check the result with show-plan.

Exit codes of execute-plan:
  0    Done
  1    Failed; nothing uncertain happened
  3    A write outcome is unknown: stop, tell the human, do not retry

Rules:
  - Never ask for or handle secret values, tokens or login codes.
  - You cannot approve or reject plans.
  - The default policy refuses production writes, even with approval.

Guide: https://github.com/feistify/secretops/blob/main/docs/AGENT_START.md
EOF_HELP
        ;;
    version | actions)
        [ "$#" -eq 0 ] || deny "$subcommand takes no arguments"
        exec "$BROKER_BIN" "$subcommand"
        ;;
    plan)
        # Exact shape: plan --file <name>.yaml --save
        [ "$#" -eq 3 ] || deny "plan requires: --file <name>.yaml --save"
        [ "$1" = "--file" ] || deny "plan requires --file as first argument"
        [ "$3" = "--save" ] || deny "plan requires --save"
        valid_recipe_name "$2" || deny "invalid recipe name"
        exec "$BROKER_BIN" plan --file "$RECIPE_DIR/$2" --save
        ;;
    show-plan | preflight-plan | execute-plan)
        # Exact shape: <subcommand> --id <plan_id>
        [ "$#" -eq 2 ] || deny "$subcommand requires: --id <plan_id>"
        [ "$1" = "--id" ] || deny "$subcommand requires --id"
        valid_plan_id "$2" || deny "invalid plan id"
        exec "$BROKER_BIN" "$subcommand" --id "$2"
        ;;
    write-recipe)
        [ "$#" -eq 1 ] || deny "write-recipe takes exactly one filename"
        valid_recipe_name "$1" || deny "invalid recipe name"
        umask 077
        mkdir -p "$RECIPE_DIR"
        tmp="$RECIPE_DIR/.tmp.$$.$1"
        # Read one byte past the cap so oversize input is rejected, not
        # silently truncated. Recipes hold names and metadata, never values.
        head -c "$((MAX_RECIPE_BYTES + 1))" > "$tmp" || {
            rm -f "$tmp"
            deny "recipe read failed"
        }
        if [ "$(wc -c < "$tmp")" -gt "$MAX_RECIPE_BYTES" ]; then
            rm -f "$tmp"
            deny "recipe exceeds $MAX_RECIPE_BYTES bytes"
        fi
        mv "$tmp" "$RECIPE_DIR/$1"
        echo "secretops-agent: wrote recipe: $RECIPE_DIR/$1"
        ;;
    *)
        deny "subcommand not allowed: $subcommand (run help for the allowed commands)"
        ;;
esac
