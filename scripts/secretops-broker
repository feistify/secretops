#!/bin/sh
# secretops-broker: run secretops with the broker host environment.
#
# Sources the broker env file (vault credentials, SECRETOPS_* pinning) and
# execs the installed secretops CLI. This is the only place vault credentials
# are loaded; agents never receive this file or its values.
#
# Install as /usr/local/bin/secretops-broker, owned by root, mode 0755.
# The env file must be owned by the broker user with mode 0600.
#
# The env-file path is hardcoded: a forced-command boundary must not let the
# client point the broker at a different env file. The one BEGIN/END CONFIG
# line is the only line a test harness rewrites. SECRETOPS_BIN,
# SECRETOPS_INFISICAL_BIN, and SECRETOPS_GH_BIN choose which programs run
# with the vault token, secret values, or the GitHub login, so they may be
# set only by the trusted broker.env, never by the client environment; any
# inherited values are cleared before sourcing.
set -eu

# --- BEGIN CONFIG (hardcoded; do not read from environment) ---
BROKER_ENV=/opt/secretops/broker.env
# --- END CONFIG ---

unset SECRETOPS_BIN SECRETOPS_INFISICAL_BIN SECRETOPS_GH_BIN 2>/dev/null || true

if [ ! -f "$BROKER_ENV" ]; then
    echo "secretops-broker: missing broker env file: $BROKER_ENV" >&2
    exit 1
fi

perms=$(stat -c '%a' "$BROKER_ENV" 2>/dev/null || stat -f '%Lp' "$BROKER_ENV" 2>/dev/null || echo unknown)
case "$perms" in
    400 | 600 | 700) ;;
    *)
        echo "secretops-broker: broker env file permissions must be 0600 (got: $perms)" >&2
        exit 1
        ;;
esac

set -a
# shellcheck disable=SC1090
. "$BROKER_ENV"
set +a

exec "${SECRETOPS_BIN:-secretops}" "$@"
