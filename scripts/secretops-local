#!/bin/sh
# secretops-local: the agent's connection to a local broker.
#
# Runs one broker command over the dedicated loopback SSH service with the
# agent key the installer created. Strict host-key checking against the
# pinned known-hosts file; no config files, agent, or interactive prompts.
#
#   secretops-local plan --file task.yaml --save
#   secretops-local write-recipe task.yaml < task.yaml
#
# Install as /usr/local/bin/secretops-local, owned by root, mode 0755. The
# one BEGIN/END CONFIG line is set by the installer.
set -eu

# --- BEGIN CONFIG ---
PORT=22222
# --- END CONFIG ---

exec /usr/bin/ssh -F /dev/null \
    -i "$HOME/.ssh/secretops_local_agent_ed25519" \
    -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes \
    -o StrictHostKeyChecking=yes \
    -o "UserKnownHostsFile=$HOME/.ssh/secretops_local_known_hosts" \
    -o RequestTTY=no -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes \
    -p "$PORT" secretops-broker@127.0.0.1 "$@"
