#!/bin/bash
# secretops-uninstall: remove a local secretops broker installed by install.sh.
#
#   sudo secretops-uninstall            # asks once; keeps plans and audit in an archive
#   sudo secretops-uninstall --purge    # asks once; no archive
#
# Removes the agent's access first, then the SSH service, the application,
# broker.env (the token), the wrappers, the broker account with its GitHub
# login, and the agent's broker key. Plans, audit and policy go to a
# root-only archive in /root unless --purge is given; the token is never
# archived. Credentials outside this machine stay valid until the human
# revokes them; the last lines say which.
#
# Install as /usr/local/sbin/secretops-uninstall, owned by root, mode 0755.
set -Eeuo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT=/opt/secretops
BROKER_USER=secretops-broker
BROKER_HOME=/var/lib/secretops-broker
UNIT=secretops-local-sshd.service
UNIT_FILE=/etc/systemd/system/$UNIT
INFO=$ROOT/install-info
PIDFILE=/run/secretops-local-sshd.pid
PROGRAMS="/usr/local/bin/secretops /usr/local/bin/secretops-broker /usr/local/bin/secretops-agent
/usr/local/bin/secretops-local /usr/local/sbin/secretops-configure /usr/local/sbin/secretops-uninstall"

die() {
    echo "secretops-uninstall: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: sudo secretops-uninstall [--purge] [--yes]

  --purge   do not keep plans, audit and policy in an archive
  --yes     do not ask (for scripts)
EOF
}

purge=0 yes=0
while [[ $# -gt 0 ]]; do
    case $1 in
        --purge) purge=1; shift ;;
        --yes) yes=1; shift ;;
        -h | --help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done

[[ $EUID == 0 ]] || die "run with sudo from your own terminal, not from an agent session"
[[ -f $INFO && ! -L $INFO ]] && grep -qx 'installer=secretops-install-1' "$INFO" \
    || die "no installation by install.sh at $ROOT; remove it with the steps it was installed with"
agent_user=$(sed -n 's/^agent_user=//p' "$INFO" | head -n 1)
# The loopback sshd runs a session process as the broker; anything else is a
# broker command still at work.
if ps -o comm= -u "$BROKER_USER" 2>/dev/null | grep -qvxE 'sshd|sshd-session'; then
    die "broker commands are running; let them finish and pause the agent first"
fi
archive=/root/secretops-uninstall-$(date -u +%Y%m%dT%H%M%SZ).tar.gz

echo "This removes the local secretops broker:"
echo "  - the agent's access ($agent_user) and the SSH service $UNIT"
echo "  - $ROOT: application, policy, plans, audit and broker.env with the vault token"
echo "  - the account $BROKER_USER and its GitHub login"
echo "  - the programs secretops, secretops-broker, secretops-agent, secretops-local,"
echo "    secretops-configure and secretops-uninstall"
if [[ $purge == 1 ]]; then
    echo "Plans and audit are deleted (--purge)."
else
    echo "Plans, audit and policy are kept in $archive (root only, no token)."
fi
if [[ $yes == 0 ]]; then
    [[ -t 0 ]] || die "no terminal to confirm; run it in your own terminal, or pass --yes"
    read -r -p "Remove the broker? [y/N] " answer
    [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || die "nothing was removed"
fi

# 1. The agent loses access first, then the service stops. Until step 4 the
# programs and install-info stay, so a failed run can be repeated.
rm -f -- "$ROOT/ssh/authorized_keys"
systemd=0
[[ -d /run/systemd/system ]] && systemd=1
if [[ $systemd == 1 ]]; then
    systemctl disable --now "$UNIT" >/dev/null 2>&1 || true
fi
if [[ -f $PIDFILE ]]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    rm -f -- "$PIDFILE"
fi
# Sessions end with the service; any broker process left would block userdel.
for _ in {1..20}; do
    pgrep -u "$BROKER_USER" >/dev/null 2>&1 || break
    sleep 0.5
done
if pgrep -u "$BROKER_USER" >/dev/null 2>&1; then
    die "processes of $BROKER_USER are still running; stop them and run secretops-uninstall again"
fi

# 2. History, unless purged. tar stores links as links and never follows them.
if [[ $purge == 0 ]]; then
    items=()
    for name in plans audit policy.yaml; do
        [[ -e $ROOT/$name ]] && items+=("$name")
    done
    if [[ ${#items[@]} -gt 0 ]]; then
        tar -C "$ROOT" -czf "$archive" "${items[@]}"
        chmod 0600 "$archive"
    fi
fi

# 3. The broker account and its home with the GitHub login.
if getent passwd "$BROKER_USER" >/dev/null; then
    userdel "$BROKER_USER" || die "could not remove $BROKER_USER; fix that and run secretops-uninstall again"
fi
rm -rf -- "$BROKER_HOME"

# 4. The agent's broker key, removed as the agent so root follows no link it placed.
if [[ -n $agent_user ]] && getent passwd "$agent_user" >/dev/null; then
    agent_home=$(getent passwd "$agent_user" | cut -d: -f6)
    runuser -u "$agent_user" -- rm -f -- "$agent_home/.ssh/secretops_local_agent_ed25519" \
        "$agent_home/.ssh/secretops_local_agent_ed25519.pub" "$agent_home/.ssh/secretops_local_known_hosts"
fi

# 5. Application with broker.env, the service file and the programs; this
# uninstaller last. A running script survives deleting its own file.
rm -f -- "$UNIT_FILE"
rm -rf -- "$ROOT"
while read -r program; do
    [[ $program == /usr/local/sbin/secretops-uninstall ]] || rm -f -- "$program"
done <<< "${PROGRAMS// /$'\n'}"
[[ $systemd == 0 ]] || systemctl daemon-reload
rm -f -- /usr/local/sbin/secretops-uninstall

echo "Removed the local secretops broker."
[[ $purge == 0 && -f $archive ]] && echo "History: $archive"
cat <<'EOF'
Still valid until you revoke them, outside this machine:
  - the Infisical machine identity token (revoke it, or delete the identity)
  - the broker's GitHub CLI authorization: https://github.com/settings/applications
Your own ~/.config/secretops/client.yaml was left in place; delete it if you no longer use secretops.
EOF
